{
	"name": "cortex-cli",
	"version": "0.2.0",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"bin": {
		"cortex": "./src/cli/main.ts"
	},
	"scripts": {
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"coverage:audit": "bun scripts/coverage-audit.ts",
		"eval:search": "bun tests/evaluation/runner.ts",
		"typecheck": "tsc --noEmit",
		"check": "bunx --bun @biomejs/biome check --write",
		"lint:ci": "bunx --bun @biomejs/biome ci",
		"build": "bun scripts/build.ts",
		"smoke:compiled": "bun scripts/compiled-smoke.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@types/bun": "1.3.14"
	},
	"peerDependencies": {
		"typescript": "7.0.2"
	},
	"dependencies": {
		"@huggingface/transformers": "4.2.0",
		"@modelcontextprotocol/sdk": "1.29.0",
		"web-tree-sitter": "0.26.11",
		"zod": "4.4.3"
	}
}
